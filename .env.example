# ---------------------------------------------------------------------------
# ForgeMind backend — environment template
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials.
# Every value below is a PLACEHOLDER. Do not commit filled-in values.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Session lifetime for issued auth tokens (days).
SESSION_TTL_DAYS=30

# Comma-separated browser origins allowed to call this API.
# Required for Expo web (the browser enforces CORS). Native iOS/Android builds
# ignore CORS entirely, so this only matters for `expo start --web`.
# Common Expo web dev origins: http://localhost:8081 and http://localhost:19006.
# Leave empty to block all browser access.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# PostgreSQL connection
# The application role MUST be a non-superuser (forgemind_app), never `postgres`.
#
# SET YOUR OWN PASSWORD — never use the placeholder. Never commit the real .env file.
#
# The five DB_* values below are the SINGLE SOURCE OF TRUTH for credentials.
# Do NOT add a hand-maintained DB_URL here: a stale copy silently overrides a
# corrected DB_PASSWORD and produces "password authentication failed".
# Both src/config.ts and scripts/migrate.mjs derive the connection string from
# these parts at run time.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=forgemind_dev
DB_USER=forgemind_app
DB_PASSWORD=your-secure-password-here
DB_SSL=false

# One-time superuser setup (run as `postgres`, NOT as forgemind_app).
# Required because PostgreSQL 15+ removed the default CREATE grant on schema
# `public`, so the app role cannot create its tables without this:
#
#   GRANT USAGE, CREATE ON SCHEMA public TO forgemind_app;
#
# Or, to hand the app role full ownership of the database instead:
#   ALTER DATABASE forgemind_dev OWNER TO forgemind_app;
